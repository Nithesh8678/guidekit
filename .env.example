# Local demo is the default. No paid model fallback is enabled.
GUIDEKIT_PROVIDER=codex
GUIDEKIT_PORT=4410
GUIDEKIT_DEMO_PORT=4411
GUIDEKIT_SECOND_DEMO_PORT=4412
GUIDEKIT_DATA_DIR=.data
GUIDEKIT_DAILY_RUN_LIMIT=500
GUIDEKIT_ACTIVE_SESSION_LIMIT=100
# Explicit local SQLite mode remains available for offline development/rollback.
# Product deployment uses PostgreSQL plus a separate restricted knowledge role.
GUIDEKIT_KNOWLEDGE_PROVIDER=local
# GUIDEKIT_DATABASE_URL=postgresql://guidekit_runtime:REPLACE@HOST/guidekit?sslmode=verify-full
# GUIDEKIT_KNOWLEDGE_PROVIDER=postgres
# GUIDEKIT_KNOWLEDGE_DATABASE_URL=postgresql://guidekit_retrieval:REPLACE@HOST/guidekit?sslmode=verify-full
# GUIDEKIT_EMBEDDING_CACHE_DIR=.data/models
# Keep the schema owner's GUIDEKIT_DATABASE_URL_DIRECT in a separate operator-only
# environment file. Never give schema-owner credentials to the running server.
# Optional hosted provider preparation. All three fields + GUIDEKIT_PROVIDER=openai
# are required before API requests can run. Keep disabled for the subscription demo.
# GUIDEKIT_OPENAI_ENABLED=false
# GUIDEKIT_OPENAI_MODEL=
# OPENAI_API_KEY=
# Optional: select a model available to your signed-in Codex account.
# GUIDEKIT_MODEL=
# Optional: absolute path to your Codex executable.
# GUIDEKIT_CODEX_BIN=codex
# Legacy migration compatibility only; no sponsor integration is required.
# GUIDEKIT_KNOWLEDGE_PROVIDER=tigergraph
# GUIDEKIT_LEGACY_TIGERGRAPH_ENABLED=true
# Install packages/graph/gsql/*.gsql first. Keep the token server-side.
# TIGERGRAPH_BASE_URL=https://your-workspace-endpoint
# TIGERGRAPH_GRAPH_NAME=GuideKit
# TIGERGRAPH_TOKEN=
# Savanna alternative to a token; configure exactly one credential:
# TIGERGRAPH_SECRET=
# TIGERGRAPH_RESTPP_PREFIX=/restpp
