{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "noEmit": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "types": ["node"],
    "baseUrl": ".",
    "paths": { "@guidekit/contracts": ["packages/contracts/src/index.ts"], "@guidekit/sdk": ["packages/sdk/src/index.ts"] }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "vite.config.ts", "playwright.config.ts"]
}
