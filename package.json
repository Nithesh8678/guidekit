{
  "name": "guidekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:dashboard": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsx scripts/build.ts",
    "start": "tsx apps/server/src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/live-proof.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "audit:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "express": "5.1.0",
    "express-rate-limit": "8.2.1",
    "express-session": "1.18.2",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "esbuild": "0.28.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
