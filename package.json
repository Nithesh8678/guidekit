{
  "name": "guidekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch apps/server/src/index.ts",
    "dev:dashboard": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node --import tsx scripts/build.ts",
    "start": "node --env-file-if-exists=.env --import tsx apps/server/src/index.ts",
    "test": "node --import tsx --test tests/*.test.ts packages/sdk/tests/*.test.ts packages/graph/tests/*.test.ts packages/runtime/src/*.test.ts",
    "test:e2e": "playwright test",
    "test:live": "node --import tsx scripts/live-proof.ts",
    "test:graph": "node --env-file-if-exists=.env --import tsx scripts/graph-proof.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "audit:secrets": "node scripts/check-secrets.mjs",
    "backup": "node --import tsx scripts/backup.ts",
    "restore": "node --import tsx scripts/restore.ts",
    "retention": "node --env-file-if-exists=.env --import tsx scripts/retention.ts",
    "test:dashboard": "playwright test --config apps/dashboard/playwright.config.ts",
    "test:dashboard:integration": "playwright test --config apps/dashboard/playwright.integration.config.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.18.2",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "aria-hidden": "1.2.6",
    "esbuild": "0.28.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
